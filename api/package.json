{
  "name": "devops-dummy-api",
  "version": "1.0.0",
  "description": "Dummy API for hands-on DevOps curriculum",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --coverageReporters=lcov --detectOpenHandles --forceExit",
    "audit": "npm audit --audit-level=high",
    "dev": "node --watch src/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
